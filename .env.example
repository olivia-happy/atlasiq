# Optional local model. Leave empty to use the deterministic, cited fallback.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional persistence services. Docker Compose provides these URLs automatically.
DATABASE_URL=postgresql+psycopg://atlasiq:atlasiq_local_only@localhost:5432/atlasiq
REDIS_URL=redis://localhost:6379/0

# Optional SMTP for the email test action. If omitted, AtlasIQ returns a safe preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional local directory for immutable report files. Defaults to ./generated-reports.
ATLASIQ_REPORT_DIR=generated-reports

# Optional free public-news polling. Set 0 to disable the in-process scheduler.
NEWS_POLL_INTERVAL_SECONDS=300
